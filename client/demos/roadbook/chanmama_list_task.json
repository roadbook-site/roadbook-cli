{
  "meta": {
    "name": "Chanmama Video List Crawler",
    "desc": "Crawl hot short videos list related to specific keywords",
    "version": "3.0"
  },
  "interface": {
    "inputs": {
      "keyword": {
        "type": "string",
        "desc": "The search keyword (e.g., 'Skincare', 'Gadgets')"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "fields": ["title", "author", "cover_url", "page_url", "publish_time"]
      }
    }
  },
  "base_url": "https://www.chanmama.com",
  "guidelines": [
    {
      "context": "Filtering",
      "rule": "Always apply 'Ecommerce' filter BEFORE typing the search keyword to prevent reset."
    },
    {
      "context": "Data Extraction",
      "rule": "Prefer extracting title from `img[alt]` or link `title` attribute to avoid truncation."
    }
  ],
  "steps": [
    {
      "id": "step_navigate_to_rank",
      "intent": "Go directly to the Video Rank/Search page",
      "action": "goto",
      "args": {
        "url": "https://www.chanmama.com/awemeRank"
      }
    },
    {
      "id": "step_click_ecommerce_filter",
      "intent": "Apply 'Ecommerce' filter first",
      "action": "click",
      "args": {
        "selector": "text='带货视频'",
        "wait_for_navigation": true
      }
    },
    {
      "id": "step_fill_search_keyword",
      "intent": "Input search keyword",
      "action": "fill",
      "args": {
        "selector": "input[placeholder*='视频标题'], input[placeholder*='达人名称']",
        "value": "{keyword}"
      }
    },
    {
      "id": "step_submit_search",
      "intent": "Trigger search",
      "action": "press",
      "args": {
        "selector": "input[placeholder*='视频标题'], input[placeholder*='达人名称']",
        "key": "Enter"
      }
    },
    {
      "id": "step_extract_video_list",
      "intent": "Extract video items from the list",
      "action": "extract",
      "args": {
        "scope": "list",
        "item_selector": "tr",
        "fields": {
          "title": { "selector": "a.title, img[alt]", "attr": "title|alt|innerText" },
          "author": { "selector": ".author-name", "attr": "innerText" },
          "cover_url": { "selector": "img.cover", "attr": "src" },
          "page_url": { "selector": "a[href*='/awemeRank/']", "attr": "href", "transform": "absolute_url" },
          "publish_time": { "selector": ".publish-time", "attr": "innerText" }
        }
      }
    },
    {
      "id": "step_click_next_page",
      "intent": "Go to next page",
      "action": "click",
      "args": {
        "selector": ".el-pagination .btn-next"
      }
    }
  ]
}
