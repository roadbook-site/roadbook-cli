# Step Profiling Helper
STEPS_TIMING = {}

@contextmanager
def step(name):
    logger.info(f"[*] Step Started: {name}...")
    start_time = time.time()
    try:
        yield
    finally:
        duration = time.time() - start_time
        STEPS_TIMING[name] = duration
        logger.info(f"    -> Step Finished: {name} (Duration: {duration:.2f}s)")

