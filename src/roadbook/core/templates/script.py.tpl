        # Fallback if utils not present or path issue
        def wait_for_page_load(page, strategy="domcontentloaded", timeout=None):
            if timeout is None:
                try:
                    from roadbook.core.config import load_config
                    timeout = load_config().get("scaffold", {}).get("default_timeout", 10000)
                except ImportError:
                    timeout = 10000
            try:
                page.wait_for_load_state(strategy, timeout=timeout)
            except:
                pass

        def get_playwright_context(headless=None, cdp_url=None, storage_state_path=None):
            from playwright.sync_api import sync_playwright
            browser_type_name = "chromium"
            if headless is None:
                try:
                    from roadbook.core.config import load_config
                    browser_config = load_config().get("scaffold", {})
                    headless = browser_config.get("headless", False)
                    browser_type_name = browser_config.get("browser_type", "chromium")
                except ImportError:
                    headless = False
            p = sync_playwright().start()
            playwright_browser_type = getattr(p, browser_type_name, p.chromium)
            if cdp_url:
                browser = playwright_browser_type.connect_over_cdp(cdp_url)
                context = browser.contexts[0] if browser.contexts else browser.new_context()
                page = context.pages[0] if context.pages else context.new_page()
                return p, browser, context, page, {"mode": "cdp", "file": None}
            else:
                browser = playwright_browser_type.launch(headless=headless)
                if storage_state_path and os.path.exists(storage_state_path):
                    context = browser.new_context(storage_state=storage_state_path)
                    return p, browser, context, page, {"mode": "storage", "file": storage_state_path}
                else:
                    context = browser.new_context()
                page = context.new_page()
                return p, browser, context, page, {"mode": "fresh", "file": None}
